# Terraform — state files hold resource attributes in plaintext, including
# anything marked sensitive. These must never reach the remote.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
tfplan
# Note: .terraform.lock.hcl is deliberately NOT ignored. It pins provider
# versions and hashes, and committing it is what makes `terraform init`
# reproducible for anyone else who clones this repo.
crash.log

# Kubernetes / Helm
kubeconfig
*.kubeconfig

# Training data. The dataset is ~30MB of Kaggle-sourced URLs and does not belong
# in git — only the fitted artifact in phishing-detector/model/ ships.
phishing_site_urls.csv
*.csv

# macOS
.DS_Store
